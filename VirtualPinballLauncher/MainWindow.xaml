<Window x:Class="VirtualPinballLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:local="clr-namespace:VirtualPinballLauncher"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="Virtual Pinball Launcher"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        Background="Black"
        KeyDown="Window_KeyDown"
        MouseWheel="Window_MouseWheel"
        Loaded="Window_Loaded">

    <Grid>

        <vlc:VideoView x:Name="PreviewPlayer"
            Focusable="False"
            IsTabStop="False"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">

            <vlc:VideoView.Content>
                <Grid>
                    <!-- Colors and bottom margin come from Appearance in config.json. -->
                    <Border x:Name="TableNameOverlay"
                            VerticalAlignment="Bottom"
                            BorderThickness="0,10,0,10"
                            Padding="24">
                        <Grid>
                            <TextBlock FontSize="250"
                                    FontFamily="./Digital Dot Roadsign.otf#Digital Dot Roadsign"
                                    FontWeight="Normal"
                                    Visibility="Hidden"
                                    Text=" "/>
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center">
                                <TextBlock x:Name="TableNameText"
                                        FontSize="200"
                                        FontFamily="./Digital Dot Roadsign.otf#Digital Dot Roadsign"
                                        FontWeight="Normal"
                                        RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform>
                                        <!-- Optical correction for the dot-matrix font's uneven vertical metrics. -->
                                        <TranslateTransform Y="-10"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Viewbox>
                        </Grid>
                    </Border>

                    <local:LoadingOverlay x:Name="LoadingOverlay"/>
                </Grid>
            </vlc:VideoView.Content>

        </vlc:VideoView>

    </Grid>

</Window>
