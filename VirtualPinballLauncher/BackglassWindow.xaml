<Window x:Class="VirtualPinballLauncher.BackglassWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:local="clr-namespace:VirtualPinballLauncher"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="Backglass"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        Background="Black"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False">
    <Grid>

        <vlc:VideoView x:Name="BackglassPlayer"
            Focusable="False"
            IsTabStop="False"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">

            <vlc:VideoView.Content>
                <local:LoadingOverlay x:Name="LoadingOverlay"/>
            </vlc:VideoView.Content>

        </vlc:VideoView>

    </Grid>
</Window>
