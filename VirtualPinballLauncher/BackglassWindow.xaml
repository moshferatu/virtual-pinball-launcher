<Window x:Class="VirtualPinballLauncher.BackglassWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="Backglass"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        Background="Black"
        ShowInTaskbar="False">
    <Grid>

        <vlc:VideoView x:Name="BackglassPlayer"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">

            <vlc:VideoView.Content>
                <Grid x:Name="LoadingOverlay" Visibility="Collapsed">
                    <Rectangle Fill="#CC000000"/>
                    <Viewbox Width="120" Height="120"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Canvas Width="50" Height="50">

                            <Ellipse Width="50" Height="50"
                                    Stroke="#33FFFFFF" StrokeThickness="5"
                                    Fill="Transparent"/>

                            <Path Width="50" Height="50" Stroke="White" StrokeThickness="5"
                                StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                Data="M 25,2.5 A 22.5,22.5 0 0 1 47.5,25"
                                RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="0"/>
                                </Path.RenderTransform>
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Style.Triggers>
                                            <Trigger Property="IsVisible" Value="True">
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard x:Name="SpinStoryboard">
                                                        <Storyboard>
                                                            <DoubleAnimation
                                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                From="0" To="360"
                                                                Duration="0:0:1"
                                                                RepeatBehavior="Forever"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="SpinStoryboard"/>
                                                </Trigger.ExitActions>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>

                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="Loading&#x2026;"
                            Foreground="#CCFFFFFF" FontSize="28"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Margin="0,180,0,0"/>
                </Grid>
            </vlc:VideoView.Content>

        </vlc:VideoView>

    </Grid>
</Window>
