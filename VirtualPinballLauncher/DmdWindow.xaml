<Window x:Class="VirtualPinballLauncher.DmdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DMD"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        Background="Black"
        Topmost="True"
        ShowInTaskbar="False">
    <Grid>
        <Border Padding="36" Background="Black">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center">

                <TextBlock x:Name="TableTitleText"
                           Foreground="White"
                           FontSize="100"
                           FontWeight="Bold"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>

                <TextBlock x:Name="PropertiesText"
                           Foreground="White"
                           FontSize="65"
                           Margin="0,24,0,0"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
