<Window x:Class="VirtualPinballLauncher.DmdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:local="clr-namespace:VirtualPinballLauncher"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DMD"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        Background="Black"
        ShowInTaskbar="False">
    <Grid>
        <Border Padding="36" Background="Black">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Stretch">

                <Grid>
                    <TextBlock FontSize="125"
                               FontFamily="./Digital Dot Roadsign.otf#Digital Dot Roadsign"
                               FontWeight="Normal"
                               Visibility="Hidden"
                               Text=" "/>
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly"
                             HorizontalAlignment="Center">
                        <TextBlock x:Name="TableTitleText"
                                   Foreground="Yellow"
                                   FontFamily="./Digital Dot Roadsign.otf#Digital Dot Roadsign"
                                   FontSize="125"
                                   FontWeight="Normal"/>
                    </Viewbox>
                </Grid>

                <TextBlock x:Name="PropertiesText"
                           Foreground="White"
                           FontFamily="./Digital Dot Roadsign.otf#Digital Dot Roadsign"
                           FontSize="80"
                           LineStackingStrategy="BlockLineHeight"
                           LineHeight="96"
                           Margin="0,24,0,0"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Visibility="Collapsed">
                    <Run Text="Times Played: " Foreground="DimGray"/><Run x:Name="TimesPlayedValue"/><LineBreak/>
                    <Run Text="Total Time Played: " Foreground="DimGray"/><Run x:Name="TotalTimePlayedValue"/><LineBreak/>
                    <Run Text="Last Played: " Foreground="DimGray"/><Run x:Name="LastPlayedValue"/>
                </TextBlock>
            </StackPanel>
        </Border>

        <local:LoadingOverlay x:Name="LoadingOverlay"/>
    </Grid>
</Window>
