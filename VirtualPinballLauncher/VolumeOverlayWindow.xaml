<Window x:Class="VirtualPinballLauncher.VolumeOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Volume Overlay"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False">
    <Grid>
        <Border x:Name="VolumePanel"
                VerticalAlignment="Bottom"
                BorderThickness="0,10,0,10"
                Padding="24"
                Visibility="Collapsed">
            <Grid>
                <!-- Hidden spacer matches the table name overlay's height so the volume
                     panel covers it exactly when shown. -->
                <TextBlock FontSize="250"
                           FontFamily="./Digital Dot Roadsign.otf#Digital Dot Roadsign"
                           FontWeight="Normal"
                           Visibility="Hidden"
                           Text=" "/>
                <StackPanel x:Name="VolumeBars"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
