<Window x:Class="VirtualPinballLauncher.VolumeOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Volume Overlay"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False">
    <Grid>
        <Border x:Name="VolumePanel"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,80"
                Padding="20,12"
                Background="#CC000000"
                BorderBrush="Yellow"
                BorderThickness="0,4,0,4"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="VOL"
                           Foreground="Yellow"
                           FontSize="40"
                           FontFamily="./Digital Dot Roadsign.otf#Digital Dot Roadsign"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0"/>
                <StackPanel x:Name="VolumeBars" Orientation="Horizontal" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
