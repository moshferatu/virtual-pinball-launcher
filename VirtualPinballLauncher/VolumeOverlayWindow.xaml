<Window x:Class="VirtualPinballLauncher.VolumeOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Volume Overlay"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False">
    <Grid>
        <Border x:Name="VolumePanel"
                VerticalAlignment="Bottom"
                Background="Black"
                BorderBrush="Red"
                BorderThickness="0,10,0,10"
                Padding="24"
                Margin="0,0,0,200"
                Visibility="Collapsed">
            <Grid>
                <!-- Hidden spacer matches the table name overlay's height so the volume
                     panel covers it exactly when shown. -->
                <TextBlock FontSize="250"
                           FontFamily="./Digital Dot Roadsign.otf#Digital Dot Roadsign"
                           FontWeight="Normal"
                           Visibility="Hidden"
                           Text=" "/>
                <StackPanel Orientation="Vertical"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="Master Volume"
                               Foreground="Yellow"
                               FontSize="125"
                               FontFamily="./Digital Dot Roadsign.otf#Digital Dot Roadsign"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,24"/>
                    <StackPanel x:Name="VolumeBars"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
